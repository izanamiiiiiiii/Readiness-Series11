+
+// NSHealthShareUsageDescription declares public read access. A profile must
+// actually grant the capability; copying an entitlement into a signature cannot.
+fn declares_health_read_access(info: &Dictionary) -> bool {
+    info.get("NSHealthShareUsageDescription")
+        .and_then(plist::Value::as_string)
+        .is_some_and(|text| !text.trim().is_empty())
+}
+fn require_healthkit_profile(required: bool, entitlements: &Dictionary) -> Result<(), Report> {
+    if required && !entitlements.get("com.apple.developer.healthkit").and_then(plist::Value::as_boolean).unwrap_or(false) {
+        bail!("Apple's provisioning profile does not grant HealthKit. Refusing to install an app that cannot request Health access. Enable HealthKit for its App ID and regenerate the profile.");
+    }
+    Ok(())
+}
+#[cfg(test)]
+mod healthkit_profile_tests {
+    use super::*;
+    #[test]
+    fn description_requires_nonempty_string() {
+        let mut info = Dictionary::new();
+        assert!(!declares_health_read_access(&info));
+        info.insert("NSHealthShareUsageDescription".into(), plist::Value::Boolean(true));
+        assert!(!declares_health_read_access(&info));
+        info.insert("NSHealthShareUsageDescription".into(), plist::Value::String("  ".into()));
+        assert!(!declares_health_read_access(&info));
+        info.insert("NSHealthShareUsageDescription".into(), plist::Value::String("Read profile".into()));
+        assert!(declares_health_read_access(&info));
+    }
+    #[test]
+    fn profile_must_grant_boolean_healthkit_only_when_required() {
+        let mut e = Dictionary::new();
+        assert!(require_healthkit_profile(false, &e).is_ok());
+        assert!(require_healthkit_profile(true, &e).is_err());
+        e.insert("com.apple.developer.healthkit".into(), plist::Value::Boolean(false));
+        assert!(require_healthkit_profile(true, &e).is_err());
+        e.insert("com.apple.developer.healthkit".into(), plist::Value::String("true".into()));
+        assert!(require_healthkit_profile(true, &e).is_err());
+        e.insert("com.apple.developer.healthkit".into(), plist::Value::Boolean(true));
+        assert!(require_healthkit_profile(true, &e).is_ok());
+    }
+}
